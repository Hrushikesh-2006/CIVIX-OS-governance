# Gemini API Key. Required for Gemini fallback AI calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Groq API Key. Required for backend AI endpoints.
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# App URL for hosted deployments.
APP_URL="YOUR_APP_URL"

# Google Maps API Key, only needed if you re-enable Google Maps APIs.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"
